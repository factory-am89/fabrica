+// ¿La carpeta no tiene nada sin guardar? Es la mitad de la condición para poder borrarla.
+import { spawnSync } from 'node:child_process';
+
+export function carpetaLimpia(carpeta) {
+  const r = spawnSync('git', ['status', '--porcelain'], { cwd: carpeta, encoding: 'utf8' });
+  return r.stdout.trim() === '';
+}
