@@ -0,0 +1,8 @@
+// Lista las carpetas dadas con su estado (solo lista; no borra nada).
+//   node scripts/limpiar-lista.mjs <carpeta> [<carpeta> ...]
+import { fileURLToPath } from 'node:url';
+import { carpetaLimpia } from './lib/carpeta-limpia.mjs';
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  for (const carpeta of process.argv.slice(2)) console.log(`${carpeta}: ${carpetaLimpia(carpeta) ? 'limpia' : 'con cambios'}`);
+}
diff --git a/test/carpeta-limpia.test.js b/test/carpeta-limpia.test.js
