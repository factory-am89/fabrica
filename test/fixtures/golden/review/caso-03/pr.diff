@@ -0,0 +1,18 @@
+// ramaValida y avisoDeRama: el formato de la rama de un encargo.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { ramaValida } from '../scripts/lib/prefijo-rama.mjs';
+import { avisoDeRama } from '../scripts/lib/aviso-rama.mjs';
+
+test('prefijo-rama: acepta feat/, fix/ y ops/ con un nombre en minúsculas', () => {
+  for (const r of ['feat/revisor', 'fix/token-cache', 'ops/limpiar-ramas']) assert.equal(ramaValida(r), true, r);
+});
+
+test('prefijo-rama: rechaza otro prefijo, mayúsculas y ramas sin nombre', () => {
+  for (const r of ['chore/x', 'feat/Revisor', 'feat/', 'main']) assert.equal(ramaValida(r), false, r);
+});
+
+test('aviso-rama: no avisa con un prefijo bueno y lista los prefijos con uno malo', () => {
+  assert.equal(avisoDeRama('fix/x'), null);
+  assert.match(avisoDeRama('chore/x'), /feat\/, fix\/, ops\//);
+});
