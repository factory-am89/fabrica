@@ -0,0 +1,7 @@
+// Comprueba que una rama empieza por un prefijo de encargo (feat/, fix/ u ops/) y un nombre en castellano.
+const PREFIJOS = ['feat', 'fix', 'ops'];
+
+export function ramaValida(rama) {
+  const m = String(rama).match(/^([a-z]+)\/([a-z0-9-]+)$/);
+  return Boolean(m) && PREFIJOS.includes(m[1]);
+}
