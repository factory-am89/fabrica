+// Mensaje para quien lanza `npm run tarea` con una rama que no sigue el formato del encargo.
+const PREFIJOS = ['feat', 'fix', 'ops'];
+
+export function avisoDeRama(rama) {
+  const prefijo = String(rama).split('/')[0];
+  if (PREFIJOS.includes(prefijo)) return null;
+  return `la rama «${rama}» debe empezar por ${PREFIJOS.map((p) => `${p}/`).join(', ')}`;
+}
diff --git a/scripts/lib/prefijo-rama.mjs b/scripts/lib/prefijo-rama.mjs
