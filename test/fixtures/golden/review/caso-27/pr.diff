+++ b/scripts/lib/quien-cede.mjs
@@ -0,0 +1,9 @@
+// Cuando dos reservas de reparto.json se pisan en un fichero, ¿cuál cede?
+import { solapan } from './work-split.mjs';
+
+// `a` y `b` son reservas { rama, ficheros, hasta }. Devuelve la rama que cede, o null si no se pisan.
+export function quienCede(a, b) {
+  const sePisan = a.ficheros.some((fa) => b.ficheros.some((fb) => solapan(fa, fb)));
+  if (!sePisan) return null;
+  return Date.parse(a.hasta) >= Date.parse(b.hasta) ? a.rama : b.rama;
+}
diff --git a/test/quien-cede.test.js b/test/quien-cede.test.js
