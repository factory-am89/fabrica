@@ -0,0 +1,19 @@
+// quienCede: dos reservas que se pisan y dos que no.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { quienCede } from '../scripts/lib/quien-cede.mjs';
+
+const reserva = (rama, ficheros, hasta) => ({ rama, ficheros, hasta });
+
+test('quien-cede: si se pisan cede la que reserva hasta más tarde', () => {
+  const a = reserva('feat/a', ['scripts/x.mjs'], '2026-10-21T10:00:00Z');
+  const b = reserva('feat/b', ['scripts/x.mjs'], '2026-10-20T18:00:00Z');
+  assert.equal(quienCede(a, b), 'feat/a');
+  assert.equal(quienCede(b, a), 'feat/a');
+});
+
+test('quien-cede: si no se pisan no cede nadie', () => {
+  const a = reserva('feat/a', ['scripts/x.mjs'], '2026-10-21T10:00:00Z');
+  const b = reserva('feat/b', ['test/y.test.js'], '2026-10-20T18:00:00Z');
+  assert.equal(quienCede(a, b), null);
+});
