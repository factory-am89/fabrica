+// Preferencias locales de la sesión, en un JSON plano de la carpeta de trabajo.
+import { readFileSync, writeFileSync } from 'node:fs';
+
+export const FICHERO_AJUSTES = '.fabrica-ajustes.json';
+
+// El fichero puede no existir todavía (sesión nueva) o no ser legible: en esos casos, sin ajustes.
+export function leerAjustes(fichero = FICHERO_AJUSTES) {
+  try {
+    return JSON.parse(readFileSync(fichero, 'utf8'));
+  } catch {
+    return {};
+  }
+}
+
+// Guarda una clave y conserva las demás.
+export function ponerAjuste(clave, valor, fichero = FICHERO_AJUSTES) {
+  const ajustes = { ...leerAjustes(fichero), [clave]: valor };
+  writeFileSync(fichero, `${JSON.stringify(ajustes, null, 2)}\n`);
+  return ajustes;
+}
