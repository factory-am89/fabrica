+// ajustes: leer y poner preferencias locales.
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { leerAjustes, ponerAjuste } from '../scripts/lib/ajustes.mjs';
+
+const dir = mkdtempSync(path.join(tmpdir(), 'ajustes-'));
+after(() => rmSync(dir, { recursive: true, force: true }));
+
+test('ajustes: sin fichero no hay ajustes', () => {
+  assert.deepEqual(leerAjustes(path.join(dir, 'no-existe.json')), {});
+});
+
+test('ajustes: poner una clave conserva las que ya había', () => {
+  const f = path.join(dir, 'a.json');
+  ponerAjuste('silencio-hooks', 'si', f);
+  ponerAjuste('color', 'no', f);
+  assert.deepEqual(JSON.parse(readFileSync(f, 'utf8')), { 'silencio-hooks': 'si', color: 'no' });
+});
+
+test('ajustes: un fichero que no es JSON se trata como vacío y la clave nueva se guarda igual', () => {
+  const f = path.join(dir, 'roto.json');
+  writeFileSync(f, '{"silencio-hooks": "si", ');
+  assert.deepEqual(leerAjustes(f), {});
+  ponerAjuste('color', 'no', f);
+  assert.deepEqual(JSON.parse(readFileSync(f, 'utf8')), { color: 'no' });
+});
