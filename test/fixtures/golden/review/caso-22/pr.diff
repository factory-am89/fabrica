+// contarRespuestas y conNo.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { conNo, contarRespuestas } from '../scripts/lib/contar-respuestas.mjs';
+
+const respuestas = [
+  { id: 'C5', respuesta: 'sí', prueba: 'x' },
+  { id: 'C6', respuesta: 'no', prueba: 'y' },
+  { id: 'C13', respuesta: 'no aplica', prueba: 'z' },
+  { id: 'C9', respuesta: 'no', prueba: 'w' },
+];
+
+test('contar: una cuenta por respuesta', () => {
+  assert.deepEqual(contarRespuestas(respuestas), { sí: 1, no: 2, 'no aplica': 1 });
+});
+
+test('contar: una respuesta fuera de vocabulario lanza', () => {
+  assert.throws(() => contarRespuestas([{ id: 'C5', respuesta: 'quizá', prueba: 'x' }]), /fuera de vocabulario: quizá/);
+});
+
+test('conNo: los ids con no, en orden', () => {
+  assert.deepEqual(conNo(respuestas), ['C6', 'C9']);
+});
