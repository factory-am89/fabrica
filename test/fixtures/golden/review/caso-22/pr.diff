+// Cuenta las respuestas de un revisor: cuántos sí, cuántos no y cuántos no aplica.
+// `respuestas` es la lista { id, respuesta, prueba } que contesta el juez.
+export function contarRespuestas(respuestas) {
+  const cuenta = { sí: 0, no: 0, 'no aplica': 0 };
+  for (const r of respuestas) {
+    if (r.respuesta !== 'sí' && r.respuesta !== 'no' && r.respuesta !== 'no aplica') throw new Error(`${r.id}: respuesta fuera de vocabulario: ${r.respuesta}`);
+    cuenta[r.respuesta] += 1;
+  }
+  return cuenta;
+}
+
+// Las preguntas con «no», en el orden en que vienen.
+export const conNo = (respuestas) => respuestas.filter((r) => r.respuesta === 'no').map((r) => r.id);
