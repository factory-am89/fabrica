@@ -0,0 +1,8 @@
+// El estado de los PR de varias ramas, preguntado a la vez.
+// `consulta(rama)` devuelve una promesa de { numero, titulo, verde }.
+export async function estadoDePrs(ramas, consulta) {
+  const resultados = await Promise.allSettled(ramas.map((rama) => consulta(rama)));
+  return resultados.filter((r) => r.status === 'fulfilled').map((r) => r.value);
+}
+
+export const linea = (pr) => `#${pr.numero} ${pr.titulo}: ${pr.verde ? 'verde' : 'pendiente'}`;
