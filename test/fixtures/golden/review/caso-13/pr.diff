+// estadoDePrs: una consulta por rama, con una consulta falsa.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { estadoDePrs, linea } from '../scripts/lib/estado-prs.mjs';
+
+const consulta = async (rama) => ({ numero: rama.length, titulo: `PR de ${rama}`, verde: rama.startsWith('feat/') });
+
+test('estadoDePrs: un estado por rama, en el orden de las ramas', async () => {
+  const prs = await estadoDePrs(['feat/a', 'fix/bb'], consulta);
+  assert.deepEqual(prs.map((p) => p.titulo), ['PR de feat/a', 'PR de fix/bb']);
+});
+
+test('estadoDePrs: sin ramas no hay estados', async () => {
+  assert.deepEqual(await estadoDePrs([], consulta), []);
+});
+
+test('linea: verde y pendiente', () => {
+  assert.equal(linea({ numero: 7, titulo: 'x', verde: true }), '#7 x: verde');
+  assert.equal(linea({ numero: 8, titulo: 'y', verde: false }), '#8 y: pendiente');
+});
