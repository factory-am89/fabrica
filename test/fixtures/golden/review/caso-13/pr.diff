@@ -0,0 +1,19 @@
+// Estado de los PR de las ramas dadas.
+//   node scripts/ramas-abiertas.mjs <rama> [<rama> ...]
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import { estadoDePrs, linea } from './lib/estado-prs.mjs';
+
+const run = promisify(execFile);
+
+async function consultaDeGitHub(rama) {
+  const { stdout } = await run('gh', ['pr', 'view', rama, '--json', 'number,title,statusCheckRollup']);
+  const pr = JSON.parse(stdout);
+  return { numero: pr.number, titulo: pr.title, verde: pr.statusCheckRollup.every((c) => c.conclusion === 'SUCCESS') };
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const prs = await estadoDePrs(process.argv.slice(2), consultaDeGitHub);
+  for (const pr of prs) console.log(linea(pr));
+}
