+// Formatea una duración en milisegundos como «1 h 02 min 03 s», «4 min 05 s» o «7 s».
+export function formatearDuracion(ms) {
+  if (!Number.isInteger(ms) || ms < 0) throw new Error('la duración debe ser un entero de milisegundos, no negativo');
+  const total = Math.floor(ms / 1000);
+  const h = Math.floor(total / 3600);
+  const m = Math.floor((total % 3600) / 60);
+  const s = total % 60;
+  const dos = (n) => String(n).padStart(2, '0');
+  if (h > 0) return `${h} h ${dos(m)} min ${dos(s)} s`;
+  if (m > 0) return `${m} min ${dos(s)} s`;
+  return `${s} s`;
+}
