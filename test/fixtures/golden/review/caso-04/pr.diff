+// formatearDuracion: milisegundos -> texto legible.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { formatearDuracion } from '../scripts/lib/duracion.mjs';
+
+test('duracion: segundos sueltos', () => {
+  assert.equal(formatearDuracion(0), '0 s');
+  assert.equal(formatearDuracion(7400), '7 s');
+});
+
+test('duracion: minutos y segundos con dos cifras', () => {
+  assert.equal(formatearDuracion(245000), '4 min 05 s');
+});
+
+test('duracion: horas, minutos y segundos', () => {
+  assert.equal(formatearDuracion(3723000), '1 h 02 min 03 s');
+});
+
+test('duracion: lo que no es un entero no negativo lanza', () => {
+  for (const x of [-1, 1.5, '5', NaN]) assert.throws(() => formatearDuracion(x), /entero de milisegundos/, String(x));
+});
+
+test('duracion: un día entero sigue contando en horas', () => {
+  assert.equal(formatearDuracion(86400000), '24 h 00 min 00 s');
+});
