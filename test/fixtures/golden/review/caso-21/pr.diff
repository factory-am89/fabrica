index 0000000..f1a62c3
--- /dev/null
+++ b/scripts/cabeza.mjs
@@ -0,0 +1,15 @@
+// Imprime la cabeza de la rama y su base con origin/main, en corto.
+//   node scripts/cabeza.mjs
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+function gitSalida(args) {
+  const r = spawnSync('git', args, { encoding: 'utf8' });
+  if (r.status !== 0) throw new Error(`git ${args.join(' ')} falló: ${r.stderr.trim()}`);
+  return r.stdout.trim();
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const base = gitSalida(['merge-base', 'origin/main', 'HEAD']);
+  console.log(`HEAD ${gitSalida(['rev-parse', '--short', 'HEAD'])}; base ${gitSalida(['rev-parse', '--short', base])}`);
+}
diff --git a/scripts/cambios.mjs b/scripts/cambios.mjs
new file mode 100644
index 0000000..9be07d4
--- /dev/null
+++ b/scripts/cambios.mjs
@@ -0,0 +1,16 @@
+// Imprime los ficheros que la rama cambia respecto a su base con origin/main, uno por línea.
+//   node scripts/cambios.mjs
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+function gitSalida(args) {
+  const r = spawnSync('git', args, { encoding: 'utf8' });
+  if (r.status !== 0) throw new Error(`git ${args.join(' ')} falló: ${r.stderr.trim()}`);
+  return r.stdout.trim();
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const base = gitSalida(['merge-base', 'origin/main', 'HEAD']);
+  const ficheros = gitSalida(['diff', '--name-only', `${base}..HEAD`]);
+  if (ficheros !== '') console.log(ficheros);
+}
diff --git a/test/cabeza-y-cambios.test.js b/test/cabeza-y-cambios.test.js
new file mode 100644
index 0000000..4d83a90
--- /dev/null
+++ b/test/cabeza-y-cambios.test.js
@@ -0,0 +1,35 @@
+// cabeza.mjs y cambios.mjs, lanzados como comandos en un repo temporal con una rama que sale de origin/main.
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+
+const RAIZ = path.join(import.meta.dirname, '..');
+const dir = mkdtempSync(path.join(tmpdir(), 'cabeza-'));
+after(() => rmSync(dir, { recursive: true, force: true }));
+const git = (...args) => spawnSync('git', ['-c', 'user.name=t', '-c', 'user.email=t@t', ...args], { cwd: dir, encoding: 'utf8' });
+const nodo = (script) => spawnSync(process.execPath, [path.join(RAIZ, 'scripts', script)], { cwd: dir, encoding: 'utf8' });
+
+test('cabeza y cambios: una rama con un commit sobre origin/main', () => {
+  git('init', '-q', '-b', 'main');
+  writeFileSync(path.join(dir, 'a.txt'), 'a');
+  git('add', '.');
+  git('commit', '-q', '-m', 'base');
+  git('update-ref', 'refs/remotes/origin/main', 'HEAD');
+  git('checkout', '-q', '-b', 'feat/x');
+  writeFileSync(path.join(dir, 'b.txt'), 'b');
+  git('add', '.');
+  git('commit', '-q', '-m', 'cambio');
+  assert.match(nodo('cabeza.mjs').stdout, /^HEAD [0-9a-f]{7,}; base [0-9a-f]{7,}\n$/);
+  assert.equal(nodo('cambios.mjs').stdout, 'b.txt\n');
+});
+
+test('cabeza y cambios: fuera de un repo salen con 1 y dicen qué git falló', () => {
+  const fuera = mkdtempSync(path.join(tmpdir(), 'fuera-'));
+  const r = spawnSync(process.execPath, [path.join(RAIZ, 'scripts', 'cambios.mjs')], { cwd: fuera, encoding: 'utf8' });
+  rmSync(fuera, { recursive: true, force: true });
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /git merge-base origin\/main HEAD falló/);
+});
