+// Resumen de lecciones por pregunta, en CSV: una línea `pregunta,lecciones` por pregunta que tiene alguna.
+//   node scripts/resumen-lecciones.mjs
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { readLessons } from './lib/lessons.mjs';
+
+const RAIZ = path.resolve(import.meta.dirname, '..');
+
+// `lecciones` es la lista de lecciones ya leídas: objetos con su `question`.
+export function resumenCsv(lecciones) {
+  const cuenta = new Map();
+  for (const l of lecciones) cuenta.set(l.question, (cuenta.get(l.question) ?? 0) + 1);
+  const filas = [...cuenta].sort(([a], [b]) => (a < b ? -1 : 1)).map(([pregunta, n]) => `${pregunta},${n}`);
+  return ['pregunta,lecciones', ...filas].join('\n');
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) console.log(resumenCsv(readLessons(RAIZ).map((l) => JSON.parse(l.text))));
diff --git a/test/resumen-lecciones.test.js b/test/resumen-lecciones.test.js
