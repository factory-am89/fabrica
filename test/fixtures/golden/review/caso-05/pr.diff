diff --git a/scripts/lib/zonas.mjs b/scripts/lib/zonas.mjs
new file mode 100644
index 0000000..ad054d6
--- /dev/null
+++ b/scripts/lib/zonas.mjs
@@ -0,0 +1,6 @@
+// La hora en cualquier zona horaria, por si hace falta más adelante (Londres, Nueva York...).
+export function horaDeZona(zona, ahora = new Date()) {
+  return ahora.toLocaleString('es-ES', { timeZone: zona });
+}
+
+export const ZONAS_CONOCIDAS = ['Europe/Madrid', 'Europe/London', 'America/New_York', 'UTC'];
