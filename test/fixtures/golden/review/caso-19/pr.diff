+// El texto corto de un estado de PR, para las líneas de `npm run sesiones`.
+export function etiquetaDeEstado(estado) {
+  switch (estado) {
+    case 'abierto':
+      return 'PR abierto';
+    case 'borrador':
+      return 'PR en borrador';
+    case 'fusionado':
+      return 'PR fusionado';
+    case 'cerrado':
+      return 'PR cerrado sin fusionar';
+    default:
+      throw new Error(`estado de PR desconocido: ${estado}`);
+  }
+}
