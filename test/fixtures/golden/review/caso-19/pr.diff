@@ -0,0 +1,15 @@
+// etiquetaDeEstado: un texto por estado y error con uno desconocido.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { etiquetaDeEstado } from '../scripts/lib/etiqueta-estado.mjs';
+
+test('etiqueta: los cuatro estados', () => {
+  assert.equal(etiquetaDeEstado('abierto'), 'PR abierto');
+  assert.equal(etiquetaDeEstado('borrador'), 'PR en borrador');
+  assert.equal(etiquetaDeEstado('fusionado'), 'PR fusionado');
+  assert.equal(etiquetaDeEstado('cerrado'), 'PR cerrado sin fusionar');
+});
+
+test('etiqueta: un estado desconocido lanza con el valor', () => {
+  assert.throws(() => etiquetaDeEstado('merged'), /desconocido: merged/);
+});
