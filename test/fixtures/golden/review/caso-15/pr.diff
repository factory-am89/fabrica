-// Lee una ficha de sesión del formato anterior: una línea `clave=valor` por campo.
-// Las fichas actuales son JSON (scripts/lib/session-log.mjs); esto solo sirvió durante el cambio.
-export function leerFormatoViejo(texto) {
-  const ficha = {};
-  for (const linea of texto.split('\n')) {
-    if (linea.trim() === '') continue;
-    const i = linea.indexOf('=');
-    if (i === -1) throw new Error(`ficha vieja: línea sin «=»: ${linea}`);
-    ficha[linea.slice(0, i)] = linea.slice(i + 1);
-  }
-  return ficha;
-}
-
-export function esFormatoViejo(texto) {
-  return !texto.trimStart().startsWith('{');
-}
