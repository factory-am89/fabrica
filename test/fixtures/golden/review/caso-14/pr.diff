+// Las lecciones agrupadas por pregunta, recorriendo la lista una sola vez.
+export function indicePorPregunta(lecciones) {
+  const indice = new Map();
+  for (const leccion of lecciones) {
+    const grupo = indice.get(leccion.question) ?? [];
+    grupo.push(leccion);
+    indice.set(leccion.question, grupo);
+  }
+  return indice;
+}
+
+export const deLaPregunta = (indice, pregunta) => indice.get(pregunta) ?? [];
