diff --git a/test/indice-lecciones.test.js b/test/indice-lecciones.test.js
new file mode 100644
index 0000000..e07a4f8
--- /dev/null
+++ b/test/indice-lecciones.test.js
@@ -0,0 +1,16 @@
+// indicePorPregunta: agrupa por pregunta sin perder ninguna lección.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { deLaPregunta, indicePorPregunta } from '../scripts/lib/indice-lecciones.mjs';
+
+const lecciones = [{ id: 'a', question: 'C5' }, { id: 'b', question: 'C9' }, { id: 'c', question: 'C5' }];
+
+test('indice: agrupa por pregunta', () => {
+  const indice = indicePorPregunta(lecciones);
+  assert.deepEqual(deLaPregunta(indice, 'C5').map((l) => l.id), ['a', 'c']);
+  assert.deepEqual(deLaPregunta(indice, 'C9').map((l) => l.id), ['b']);
+});
+
+test('indice: una pregunta sin lecciones da una lista vacía', () => {
+  assert.deepEqual(deLaPregunta(indicePorPregunta(lecciones), 'C12'), []);
+});
