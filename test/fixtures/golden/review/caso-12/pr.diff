+// retencion: días de retención desde el entorno y si una sesión ya es vieja.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { diasDeRetencion, esVieja } from '../scripts/lib/retencion.mjs';
+
+const DIA = 24 * 60 * 60 * 1000;
+
+test('retencion: sin variable, 30 días', () => {
+  assert.equal(diasDeRetencion({}), 30);
+});
+
+test('retencion: con la variable puesta manda la variable', () => {
+  assert.equal(diasDeRetencion({ FABRICA_RETENCION_DIAS: '7' }), 7);
+});
+
+test('retencion: una variable que no es un número vuelve a los 30 días', () => {
+  assert.equal(diasDeRetencion({ FABRICA_RETENCION_DIAS: 'treinta' }), 30);
+});
+
+test('retencion: es vieja pasados los días y no antes', () => {
+  const ahora = Date.UTC(2026, 9, 20);
+  assert.equal(esVieja(ahora - 31 * DIA, ahora, 30), true);
+  assert.equal(esVieja(ahora - 29 * DIA, ahora, 30), false);
+});
