+++ b/scripts/lib/retencion.mjs
@@ -0,0 +1,11 @@
+// Cuántos días se guarda un fichero de sesión sin tocar antes de poder purgarlo.
+const DIA_MS = 24 * 60 * 60 * 1000;
+
+export function diasDeRetencion(env = process.env) {
+  return Number(env.FABRICA_RETENCION_DIAS) || 30;
+}
+
+// `ultima` y `ahora` son instantes en milisegundos; el reloj entra siempre por parámetro.
+export function esVieja(ultima, ahora, dias) {
+  return ahora - ultima > dias * DIA_MS;
+}
