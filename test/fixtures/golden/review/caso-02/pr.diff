+// nombreDeRama: título -> nombre de rama.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync } from 'node:fs';
+import { nombreDeRama } from '../scripts/lib/nombre-rama.mjs';
+
+test('nombre-rama: el módulo existe y exporta la función', () => {
+  assert.ok(existsSync(new URL('../scripts/lib/nombre-rama.mjs', import.meta.url)));
+  assert.equal(typeof nombreDeRama, 'function');
+});
+
+test('nombre-rama: un título normal no lanza', () => {
+  assert.doesNotThrow(() => nombreDeRama('Conjunto de prueba del revisor'));
+});
