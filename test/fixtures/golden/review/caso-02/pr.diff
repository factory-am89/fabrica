diff --git a/scripts/lib/nombre-rama.mjs b/scripts/lib/nombre-rama.mjs
new file mode 100644
index 0000000..96756f3
--- /dev/null
+++ b/scripts/lib/nombre-rama.mjs
@@ -0,0 +1,12 @@
+// Convierte un título en el nombre de una rama: minúsculas, sin tildes, palabras unidas por guiones.
+// Lo usará `npm run tarea` en el siguiente trozo para proponer el nombre de la rama.
+export function nombreDeRama(titulo) {
+  const base = String(titulo)
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (!base) throw new Error('el título no tiene ninguna letra ni número');
+  return base;
+}
