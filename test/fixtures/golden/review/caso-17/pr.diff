--- /dev/null
+++ b/test/porcentaje.test.js
@@ -0,0 +1,19 @@
+// porcentaje: parte y total -> «n %».
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { porcentaje } from '../scripts/lib/porcentaje.mjs';
+
+test('porcentaje: redondea al entero más cercano', () => {
+  assert.equal(porcentaje(3, 8), '38 %');
+  assert.equal(porcentaje(1, 3), '33 %');
+});
+
+test('porcentaje: los extremos', () => {
+  assert.equal(porcentaje(0, 5), '0 %');
+  assert.equal(porcentaje(5, 5), '100 %');
+});
+
+test('porcentaje: un total que no sirve o una parte fuera de rango lanza', () => {
+  assert.throws(() => porcentaje(1, 0), /total/);
+  assert.throws(() => porcentaje(6, 5), /parte/);
+});
