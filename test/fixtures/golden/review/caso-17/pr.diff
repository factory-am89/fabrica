@@ -0,0 +1,6 @@
+// «38 %» para 3 de 8. Redondea al entero más cercano.
+export function porcentaje(parte, total) {
+  if (!Number.isInteger(total) || total <= 0) throw new Error('el total debe ser un entero mayor que cero');
+  if (!Number.isInteger(parte) || parte < 0 || parte > total) throw new Error('la parte debe ser un entero entre 0 y el total');
+  return `${Math.round((parte / total) * 100)} %`;
+}
diff --git a/test/porcentaje.test.js b/test/porcentaje.test.js
new file mode 100644
